{
  "name": "awesome-rgbdt-manipulation-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "validate:data": "python3 ../scripts/validate.py",
    "format": "prettier --write src scripts astro.config.mjs",
    "format:check": "prettier --check src scripts astro.config.mjs"
  },
  "dependencies": {
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^24.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.2"
  }
}
